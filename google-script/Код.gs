         'каждый одним предложением, без вступления и без общих слов. Пиши по-русски.'
};

/**
 * Совет от модели Claude по присланным цифрам. Без ключа отвечает source: 'none',
 * и приложение строит совет само по правилам.
 */
function совет_(вид, данные) {
  if (!РОЛИ[вид]) return { error: 'Неизвестный советник' };
  if (!естьКлючМодели_()) return { source: 'none', text: '' };
  var текст = String(данные || '').slice(0, 6000);
  var ответ = UrlFetchApp.fetch('https://api.anthropic.com/v1/messages', {
    method: 'post',
    contentType: 'application/json',
    headers: { 'x-api-key': НАСТРОЙКИ.anthropicКлюч, 'anthropic-version': '2023-06-01' },
    payload: JSON.stringify({
      model: 'claude-opus-5',
      max_tokens: 1024,
      output_config: { effort: 'low' },
      system: РОЛИ[вид],
      messages: [{ role: 'user', content: 'Цифры: ' + текст }]
    }),
    muteHttpExceptions: true
  });
  var код = ответ.getResponseCode();
  if (код !== 200) {
    Logger.log('Модель ответила ' + код + ': ' + ответ.getContentText().slice(0, 300));
    return { source: 'error', text: '', error: код === 401 ? 'Ключ модели не принят' : ('Модель ответила ошибкой ' + код) };
  }
  var тело = JSON.parse(ответ.getContentText() || '{}');
  if (тело.stop_reason === 'refusal') return { source: 'error', text: '', error: 'Модель отказалась отвечать' };
  var строки = (тело.content || []).filter(function (б) { return б.type === 'text'; }).map(function (б) { return б.text; });
  return { source: 'claude', text: строки.join('\n').trim() };
}

/** Проверка советника: с ключом спросит модель, без ключа скажет, что ключа нет. */
function проверкаСоветника() {
  if (!естьКлючМодели_()) { Logger.log('Ключа модели нет: советники работают по правилам, это нормально.'); return; }
  var р = совет_('coach', JSON.stringify([{ цель: 'Спорт, тренировок в месяц', прогресс: '0%' }]));
  Logger.log(р.error ? ('Ошибка: ' + р.error) : ('Модель ответила:\n' + р.text));
}

/* ====================== календарь ====================== */

/**
 * Google-календарь той же почты. Дело со временем становится встречей на час,
 * встреча из календаря становится делом в списке, отметка «сделано» ставит
 * галочку в названии встречи. Включается функцией подключитьКалендарь.
 */
function календарьВключён_() {
  return PropertiesService.getScriptProperties().getProperty('календарь') === 'вкл';
}

function календарь_() {
  try { return CalendarApp.getDefaultCalendar(); } catch (e) { Logger.log('Календарь недоступен: ' + e); return null; }
}

function датаДня_(ключДня) {
  var ч = ключДня.split('-');
  return new Date(Number(ч[0]), Number(ч[1]) - 1, Number(ч[2]));
}

/** Создаёт встречу для дела со временем. Дела без времени в календарь не идут. */
function делоВКалендарь_(дело, ключДня) {
  if (!календарьВключён_() || !дело.when || дело.calId) return;
  var м = String(дело.when).match(/^(\d{1,2}):(\d{2})$/);
  if (!м) return;
  var к = календарь_(); if (!к) return;
  try {
    var начало = датаДня_(ключДня);
    начало.setHours(Number(м[1]), Number(м[2]), 0, 0);
    var конец = new Date(начало.getTime() + 60 * 60 * 1000);
    var событие = к.createEvent(дело.text, начало, конец, { description: 'Из Shumm' });
    дело.calId = событие.getId();
  } catch (e) { Logger.log('Не удалось создать встречу «' + дело.text + '»: ' + e); }
}

/** Галочка в названии встречи, когда дело закрыто; снятие галочки, когда открыто снова. */
function отметкаВКалендарь_(дело) {
  if (!календарьВключён_() || !дело.calId) return;
  var к = календарь_(); if (!к) return;
  try {
    var событие = к.getEventById(дело.calId); if (!событие) return;
    var название = событие.getTitle().replace(/^✓\s*/, '');
    событие.setTitle((дело.done ? '✓ ' : '') + название);
  } catch (e) { Logger.log('Не удалось отметить встречу: ' + e); }
}

/**
 * Список дел дня вместе со встречами из календаря. Встречи, которых в списке
 * ещё нет, добавляются; встречи, созданные из дел, не дублируются.
 */
function делаСКалендарём_(ключДня) {
  var список = делаЗаДень_(ключДня);
  if (!календарьВключён_()) return список;
  var к = календарь_(); if (!к) return список;
  var известные = {};
  список.forEach(function (д) { if (д.calId) известные[д.calId] = true; if (д.id) известные[д.id] = true; });
  var добавлено = 0;
  try {
    к.getEventsForDay(датаДня_(ключДня)).forEach(function (с) {
      var id = с.getId();
      if (известные[id] || известные['cal-' + id]) return;
      var название = с.getTitle() || 'Встреча';
      var готово = /^✓\s*/.test(название);
      список.push({
        id: 'cal-' + id, calId: id,
        text: название.replace(/^✓\s*/, ''),
        when: с.isAllDayEvent() ? '' : Utilities.formatDate(с.getStartTime(), 'Europe/Moscow', 'HH:mm'),
        done: готово, cal: true, ts: Date.now()
      });
      добавлено++;
    });
  } catch (e) { Logger.log('Календарь не прочитался: ' + e); }
  if (добавлено) {
    список.sort(function (a, b) { return (a.when || '99') < (b.when || '99') ? -1 : 1; });
    сохранитьДела_(ключДня, список);
  }
  return список;
}

/** Включает связь с календарём и ставит ему московское время. Запускать один раз. */
function подключитьКалендарь() {
  var к = календарь_();
  if (!к) { Logger.log('Календарь не открылся. Разрешите доступ и запустите снова.'); return 'Нет доступа'; }
  try { к.setTimeZone('Europe/Moscow'); } catch (e) { Logger.log('Часовой пояс не сменился: ' + e); }
  PropertiesService.getScriptProperties().setProperty('календарь', 'вкл');
  var сегодня = делаСКалендарём_(сегодняКлюч_());
  Logger.log('КАЛЕНДАРЬ ПОДКЛЮЧЁН: ' + к.getName() + ', часовой пояс ' + к.getTimeZone() +
    '. Дел на сегодня вместе со встречами: ' + сегодня.length + '.');
  return 'Календарь подключён';
}

/** Выключает связь: встречи не создаются и не читаются, уже созданные остаются. */
function отключитьКалендарь() {
  PropertiesService.getScriptProperties().deleteProperty('календарь');
  Logger.log('Календарь отключён.');
}

/* ====================== расписание ====================== */

function включитьРасписание() {
  var былОпрос = естьТриггер_('секретарьОпрос');
  ScriptApp.getProjectTriggers().forEach(function (т) { ScriptApp.deleteTrigger(т); });
  if (былОпрос) ScriptApp.newTrigger('секретарьОпрос').timeBased().everyMinutes(1).create();
  // Пересчёт месяца целиком, а не дописывание строки: в 8:30 сегодняшний день
  // ещё пустой, и заявки записывались нулями. Так вчера закрывается полностью.
  ScriptApp.newTrigger('перезаполнитьМесяц').timeBased().atHour(8).nearMinute(30).everyDays(1).create();
  ScriptApp.newTrigger('отправитьСводку').timeBased().atHour(9).nearMinute(0).everyDays(1).create();
  ScriptApp.newTrigger('секретарьУтром').timeBased().atHour(9).nearMinute(5).everyDays(1).create();
  Logger.log('Расписание включено: отчёт в 8:30, сводка в 9:00, секретарь в 9:05.');
  return 'Расписание включено: отчёт в 8:30, сводка в 9:00, секретарь в 9:05';
}

/** Показывает, какие настройки скрипт помнит, не раскрывая сами токены. */
function проверкаНастроек() {
  var хранилище = PropertiesService.getScriptProperties();
  ХРАНИМЫЕ_НАСТРОЙКИ.forEach(function (имя) {
    var текущее = String(НАСТРОЙКИ[имя] || '');
    var вПамяти = хранилище.getProperty('настройка:' + имя);
    var вид = !текущее ? 'пусто' : текущее.indexOf('ВСТАВЬТЕ') === 0 ? 'ЗАГЛУШКА' :
      (текущее.length > 12 ? текущее.slice(0, 4) + '…' + текущее.slice(-4) : текущее);
    Logger.log(имя + ': ' + вид + (вПамяти ? ' (есть в памяти)' : ' (в памяти нет)'));
  });
  Logger.log('Версия текста: ' + ВЕРСИЯ);
}

/** Проверка связи. Запустите её первой: в журнале появятся ваши цифры. */
function проверка() {
  var ц = собратьЦифры();
  Logger.log('ИТОГО за месяц: квалы ' + ц.funnel.quals + ', замеры ' + ц.funnel.measures +
    ', договоры ' + ц.funnel.contracts + ', сумма ' + ц.plan.done + ' руб');
  Logger.log('Конверсия квал → замер: ' + ц.conversion.current + '% при цели ' + ц.conversion.goal + '%');
  Logger.log('По воронкам: ' + JSON.stringify(ц.byPipeline));
  Logger.log('В отложенном спросе: ' + ц.deferred);
  Logger.log('Менеджеры: ' + JSON.stringify(ц.managers));
  Logger.log('Зависших сделок: ' + ц.problems.length);
  if (ц.warnings.length) Logger.log('Внимание: ' + ц.warnings.join('; '));
  return ц;
}
