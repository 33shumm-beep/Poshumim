/**
 * Shumm — связь с AmoCRM без отдельных сервисов.
 *
 * Скрипт живёт внутри Google и делает три вещи:
 *   1. Отдаёт приложению Shumm готовые цифры по адресу веб-приложения.
 *   2. Заполняет ежедневный отчёт в таблице в 10:00 по Москве, за вчерашний день.
 *   3. Присылает утреннюю сводку в Telegram в 9:00.
 *   4. В 9:05 секретарь спрашивает дела на день и кладёт ответ в список приложения.
 *   5. Дела со временем попадают в Google-календарь, встречи из календаря — в список дел.
 *
 * Настраивается один раз: заполните НАСТРОЙКИ ниже, запустите функцию
 * включитьРасписание, затем подключитьСекретаря. Всё остальное произойдёт само.
 */

// Номер версии. Чтобы убедиться, что в Google встала именно эта, найдите строку через Ctrl+F.
var ВЕРСИЯ = 'Shumm v20 · квалы по этапам, лист «Разбор дня» 26.09';

var НАСТРОЙКИ = {
  // Токен AmoCRM. Вставьте между кавычками.
  токен: 'ВСТАВЬТЕ_ТОКЕН_СЮДА',

  // Адрес аккаунта без .amocrm.ru
  поддомен: 'macridin',

  // Ключ, который защищает адрес от посторонних. Придумайте любой набор букв.
  ключ: 'shumm-8f3a21',

  планМесяца: 17000000,
  цельКонверсии: 80,
  срокЦели: '18 ноября',

  // Таблица отчёта. Пусто означает «заведи свою и запомни».
  // Исходный отчёт отдела лежит в формате Excel и принадлежит другому человеку,
  // писать в него нельзя, поэтому агент ведёт собственную таблицу.
  таблицаId: '1bE0-C2NKdDyPTp_P-5c4fyOGwfP1dlooQjRu9AlffFw',

  // Запросы для новостных агентов. Меняются свободно, это обычные поисковые слова.
  новости: {
    город: 'Тамбов',
    рынок: 'рынок ремонта квартир отделка застройщики',
    финансы: 'ключевая ставка рубль экономика'
  },

  // Telegram. Номер чата оставьте пустым: скрипт найдёт его сам,
  // как только вы напишете боту любое сообщение.
  telegramТокен: 'ВСТАВЬТЕ_ТОКЕН_БОТА',
  telegramЧат: '',

  // Необязательно. Ключ к модели Claude (console.anthropic.com). Если пусто,
  // советники в приложении работают по правилам из ваших цифр, без модели.
  anthropicКлюч: ''
};

/**
 * Токены живут ещё и в памяти скрипта, отдельно от текста. Если при обновлении
 * текста в настройках остались заглушки, скрипт возьмёт токены из памяти,
 * а если в тексте вписаны настоящие, запомнит их. Обновление текста больше
 * не может потерять токен.
 */
var ХРАНИМЫЕ_НАСТРОЙКИ = ['токен', 'telegramТокен', 'telegramЧат', 'ключ', 'таблицаId', 'anthropicКлюч'];
(function () {
  var хранилище;
  try { хранилище = PropertiesService.getScriptProperties(); } catch (e) { return; }
  ХРАНИМЫЕ_НАСТРОЙКИ.forEach(function (имя) {
    var вТексте = НАСТРОЙКИ[имя] || '';
    var заглушка = !вТексте || String(вТексте).indexOf('ВСТАВЬТЕ') === 0;
    var вПамяти = хранилище.getProperty('настройка:' + имя);
    if (!заглушка && вТексте !== вПамяти) хранилище.setProperty('настройка:' + имя, вТексте);
    if (заглушка && вПамяти) НАСТРОЙКИ[имя] = вПамяти;
  });
})();

var ВЫИГРАНА = 142, ПРОИГРАНА = 143;

/**
 * Рабочие воронки и опорные этапы. Номера взяты из вашего аккаунта,
 * поэтому считаем точно, а не по совпадению слов в названии.
 */
var ВОРОНКИ = {
  5466436: {  // Основная воронка
    имя: 'Основная воронка',
    квал: 55021342,      // Квалифицированна
    замер: 48427108,     // Замер согласован
    неЗамер: []
  },
  10764258: { // Тихие стены
    имя: 'Тихие стены',
    квал: 84766366,      // квалифицирована
    замер: 87672278,     // замер назначен
    неЗамер: [84766370]  // «Отложенный спрос» стоит после замера, но замера там не было
  }
};
var ВОРОНКА_ОТЛОЖЕННЫХ = 10520622;

/* ====================== адрес для приложения ====================== */

function doGet(e) {
  var параметры = (e && e.parameter) || {};
  var ответ;
  запомнитьАдрес_();

  if (параметры.key !== НАСТРОЙКИ.ключ) {
    ответ = { error: 'Неверный ключ' };
  } else if (параметры.do === 'version') {
    ответ = { version: ВЕРСИЯ, secretary: естьТриггер_('секретарьОпрос'), advisor: естьКлючМодели_(), calendar: календарьВключён_(),
              project: ScriptApp.getScriptId().slice(0, 8), triggers: ScriptApp.getProjectTriggers().length };
  } else if (параметры.do === 'state') {
    // Финансы, цели и списки на неделю и месяц: общие для всех устройств.
    ответ = { version: ВЕРСИЯ, state: прочитатьСостояние_() };
  } else if (параметры.do === 'advice') {
    ответ = совет_(параметры.kind, параметры.data);
  } else if (параметры.do === 'tasks') {
    // Дела от секретаря: лёгкий запрос, AmoCRM не трогаем.
    var день = ключДня_(параметры.date);
    ответ = { version: ВЕРСИЯ, date: день, tasks: делаСКалендарём_(день), calendar: календарьВключён_() };
  } else if (параметры.do === 'task-done') {
    // Галочка из приложения: отмечаем дело выполненным и возвращаем весь список.
    ответ = отметитьДелоВПриложении_(параметры.id, параметры.value !== '0', ключДня_(параметры.date));
  } else if (параметры.do === 'task-add') {
    // Дело, добавленное руками в приложении, ложится туда же, куда кладёт секретарь.
    ответ = добавитьДелоИзПриложения_(параметры.text, параметры.when, ключДня_(параметры.date));
  } else {
    try {
      ответ = собратьЦифры();
      ответ.version = ВЕРСИЯ;
    } catch (err) {
      ответ = { error: String(err && err.message ? err.message : err) };
    }
  }

  var текст = JSON.stringify(ответ);

  // Если браузер просит через callback, отвечаем в формате JSONP:
  // так запрос проходит даже при строгих настройках безопасности.
  if (параметры.callback) {
    return ContentService
      .createTextOutput(параметры.callback + '(' + текст + ')')
      .setMimeType(ContentService.MimeType.JAVASCRIPT);
  }
  return ContentService.createTextOutput(текст).setMimeType(ContentService.MimeType.JSON);
}

/* ====================== работа с AmoCRM ====================== */

function запросAmo_(путь, параметры) {
  var адрес = 'https://' + НАСТРОЙКИ.поддомен + '.amocrm.ru/api/v4/' + путь;
  if (параметры) {
    var части = [];
    for (var ключ in параметры) части.push(encodeURIComponent(ключ) + '=' + encodeURIComponent(параметры[ключ]));
    if (части.length) адрес += '?' + части.join('&');
  }
  var ответ = UrlFetchApp.fetch(адрес, {
    method: 'get',
    headers: { Authorization: 'Bearer ' + НАСТРОЙКИ.токен },
    muteHttpExceptions: true
  });
  var код = ответ.getResponseCode();
  if (код === 204) return {};
  if (код === 401) throw new Error('AmoCRM не принял токен. Проверьте, что он вставлен целиком.');
  if (код >= 400) throw new Error('AmoCRM ответил ошибкой ' + код + ' на запросе ' + путь);
  return JSON.parse(ответ.getContentText() || '{}');
}

/** Начало текущего месяца в секундах. */
function началоМесяца_() {
  var н = new Date();
  return Math.floor(new Date(н.getFullYear(), н.getMonth(), 1).getTime() / 1000);
}

/** Забирает сделки страницами, чтобы ничего не потерялось при большом объёме. */
function страницы_(фильтр) {
  var всё = [], страница = 1;
  while (страница <= 12) {
    var параметры = { limit: 250, page: страница };
    for (var к in фильтр) параметры[к] = фильтр[к];
    var порция = ((запросAmo_('leads', параметры) || {})._embedded || {}).leads || [];
    всё = всё.concat(порция);
    if (порция.length < 250) break;
    страница++;
    Utilities.sleep(300); // AmoCRM не любит больше семи обращений в секунду
  }
  return всё;
}

/** Сделки, пришедшие в этом месяце. По ним считаются заявки, квалы и замеры. */
function сделкиЗаМесяц_() {
  return страницы_({ 'filter[created_at][from]': началоМесяца_() });
}

/**
 * Сделки, подписанные в этом месяце, независимо от того, когда они пришли.
 * План закрывается датой подписания: сделка из августа, подписанная в сентябре,
 * идёт в сентябрьскую выручку. По дате создания она бы потерялась.
 */
function сделкиЗакрытые_() {
  return страницы_({ 'filter[closed_at][from]': началоМесяца_() })
    .filter(function (с) { return с.status_id === ВЫИГРАНА; });
}

function собратьЦифры() {
  var воронки = (запросAmo_('leads/pipelines')._embedded || {}).pipelines || [];
  var сделки = сделкиЗаМесяц_();
  var люди = (запросAmo_('users')._embedded || {}).users || [];

  // Порядок этапов: номер этапа -> {порядок, воронка, название}
  var этапы = {}, справочник = [];
  воронки.forEach(function (в) {
    var список = (в._embedded || {}).statuses || [];
    справочник.push({
      воронка: в.name, id: в.id,
      этапы: список.map(function (с) { return { id: с.id, название: с.name, порядок: с.sort }; })
    });
    список.forEach(function (с) { этапы[с.id] = { порядок: с.sort, воронка: в.id, название: с.name }; });
  });

  var замечания = [];
  for (var код in ВОРОНКИ) {
    var н = ВОРОНКИ[код];
    if (!этапы[н.квал]) замечания.push('в воронке «' + н.имя + '» пропал этап квалификации');
    if (!этапы[н.замер]) замечания.push('в воронке «' + н.имя + '» пропал этап замера');
  }

  // Сделка дошла до опорного этапа, если её этап не раньше по порядку.
  function дошла(сделка, опорный, исключения) {
    if (сделка.status_id === ВЫИГРАНА) return true;
    if (сделка.status_id === ПРОИГРАНА) return false;
    if (исключения && исключения.indexOf(сделка.status_id) > -1) return false;
    var текущий = этапы[сделка.status_id], цель = этапы[опорный];
    if (!текущий || !цель) return false;
    return текущий.порядок >= цель.порядок;
  }

  var рабочие = сделки.filter(function (с) {
    return ВОРОНКИ[с.pipeline_id] && с.status_id !== ПРОИГРАНА;
  });
  var отложенные = сделки.filter(function (с) {
    return с.pipeline_id === ВОРОНКА_ОТЛОЖЕННЫХ && с.status_id !== ПРОИГРАНА;
  }).length;

  var закрытые = сделкиЗакрытые_().filter(function (с) { return ВОРОНКИ[с.pipeline_id]; });
  var договоры = закрытые.length;
  var сумма = закрытые.reduce(function (и, с) { return и + (с.price || 0); }, 0);

  var квалы = 0, замеры = 0, поВоронкам = {};
  рабочие.forEach(function (с) {
    var н = ВОРОНКИ[с.pipeline_id];
    поВоронкам[н.имя] = поВоронкам[н.имя] || { квалы: 0, замеры: 0, договоры: 0 };
    if (дошла(с, н.квал, null)) { квалы++; поВоронкам[н.имя].квалы++; }
    if (дошла(с, н.замер, н.неЗамер)) { замеры++; поВоронкам[н.имя].замеры++; }
  });
  закрытые.forEach(function (с) {
    var имя = ВОРОНКИ[с.pipeline_id].имя;
    поВоронкам[имя] = поВоронкам[имя] || { квалы: 0, замеры: 0, договоры: 0 };
    поВоронкам[имя].договоры++;
  });

  var поЛюдям = {};
  рабочие.forEach(function (с) {
    var id = с.responsible_user_id;
    поЛюдям[id] = поЛюдям[id] || { всего: 0, выиграно: 0 };
    поЛюдям[id].всего++;
    if (с.status_id === ВЫИГРАНА) поЛюдям[id].выиграно++;
  });
  function инициалы(имя) {
    return String(имя || '').split(' ').filter(String).slice(0, 2)
      .map(function (ч) { return ч.charAt(0).toUpperCase() + '.'; }).join(' ');
  }
  var менеджеры = люди.filter(function (ч) { return поЛюдям[ч.id]; }).map(function (ч) {
    var s = поЛюдям[ч.id];
    return { name: инициалы(ч.name), area: '', pct: Math.round(s.выиграно / s.всего * 100) };
  }).sort(function (a, b) { return b.pct - a.pct; });

  var сейчас = Math.floor(Date.now() / 1000), ЧАС = 3600;
  var проблемы = рабочие.filter(function (с) {
    return с.status_id !== ВЫИГРАНА && сейчас - (с.updated_at || с.created_at || сейчас) > 48 * ЧАС;
  }).sort(function (a, b) { return (a.updated_at || 0) - (b.updated_at || 0); }).slice(0, 5).map(function (с) {
    return {
      id: String(с.id),
      title: с.name || ('Сделка №' + с.id),
      note: 'без касания, ' + ((этапы[с.status_id] || {}).название || 'этап неизвестен'),
      age: Math.round((сейчас - (с.updated_at || сейчас)) / ЧАС) + ' ч',
      level: 'bad'
    };
  });

  return {
    updated: new Date().toISOString(),
    plan: { target: НАСТРОЙКИ.планМесяца, done: сумма },
    conversion: {
      current: квалы ? Math.round(замеры / квалы * 100) : 0,
      goal: НАСТРОЙКИ.цельКонверсии,
      deadline: НАСТРОЙКИ.срокЦели,
      history: историяКонверсии_(квалы ? Math.round(замеры / квалы * 100) : 0)
    },
    funnel: { quals: квалы, measures: замеры, contracts: договоры },
    managers: менеджеры,
    problems: проблемы,
    deferred: отложенные,
    byPipeline: поВоронкам,
    news: новости_(),
    warnings: замечания,
    _ref: справочник
  };
}

/** Копит конверсию по дням, чтобы на графике была динамика, а не одна точка. */
function историяКонверсии_(текущая) {
  var хранилище = PropertiesService.getScriptProperties();
  var сырое = хранилище.getProperty('история');
  var история = сырое ? JSON.parse(сырое) : [];
  var сегодня = Utilities.formatDate(new Date(), 'Europe/Moscow', 'yyyy-MM-dd');
  if (!история.length || история[история.length - 1].d !== сегодня) {
    история.push({ d: сегодня, v: текущая });
  } else {
    история[история.length - 1].v = текущая;
  }
  история = история.slice(-30);
  хранилище.setProperty('история', JSON.stringify(история));
  return история.map(function (т) { return т.v; });
}

/* ====================== новости ====================== */

/**
 * Новости по запросу. Источник — новостная лента Google, она отдаёт
 * результат обычным XML и не требует ключей и регистрации.
 */
function новостиПоЗапросу_(запрос, сколько) {
  if (!запрос) return [];
  var адрес = 'https://news.google.com/rss/search?q=' + encodeURIComponent(запрос) +
    '&hl=ru&gl=RU&ceid=RU:ru';
  try {
    var ответ = UrlFetchApp.fetch(адрес, { muteHttpExceptions: true, followRedirects: true });
    if (ответ.getResponseCode() !== 200) {
      Logger.log('Новости «' + запрос + '»: источник ответил ' + ответ.getResponseCode());
      return [];
    }
    var корень = XmlService.parse(ответ.getContentText()).getRootElement();
    var канал = корень.getChild('channel');
    if (!канал) return [];
    var статьи = канал.getChildren('item').slice(0, сколько || 3);
    return статьи.map(function (статья) {
      var заголовок = статья.getChildText('title') || '';
      var источник = статья.getChild('source');
      return {
        title: заголовок.replace(/\s+-\s+[^-]+$/, ''),   // хвост с названием издания убираем
        source: источник ? источник.getText() : '',
        link: статья.getChildText('link') || '',
        date: статья.getChildText('pubDate') || ''
      };
    });
  } catch (e) {
    Logger.log('Новости «' + запрос + '» не разобрались: ' + e);
    return [];
  }
}

/** Все три новостные подборки разом, с запасом по времени: результат кешируется. */
function новости_() {
  var кеш = CacheService.getScriptCache();
  var готовое = кеш.get('новости');
  if (готовое) { try { return JSON.parse(готовое); } catch (e) {} }

  var н = НАСТРОЙКИ.новости || {};
  var собрано = {
    city: новостиПоЗапросу_(н.город, 3),
    market: новостиПоЗапросу_(н.рынок, 3),
    finance: новостиПоЗапросу_(н.финансы, 3)
  };
  try { кеш.put('новости', JSON.stringify(собрано), 3600); } catch (e) {}
  return собрано;
}

/** Проверка новостных лент отдельно от всего остального. */
function проверкаНовостей() {
  var н = новости_();
  ['city', 'market', 'finance'].forEach(function (раздел) {
    Logger.log(раздел + ': ' + (н[раздел] || []).length + ' заголовков');
    (н[раздел] || []).forEach(function (с) { Logger.log('   ' + с.title); });
  });
  return н;
}

/* ====================== утренний отчёт ====================== */

/**
 * Отчёт ведётся в формате отчёта отдела («Отчет по продажам.xlsx»): лист на месяц
 * с именем вида «Сентябрь - 2026», строка на день. Каждое утро в 10:00 заполняется
 * строка за вчера: к этому времени менеджеры успевают квалифицировать вчерашние заявки.
 *
 * Заявки и квалы считаются только по Основной воронке и Отложенному спросу.
 * Квал — это вчерашняя заявка, которая к 10:00 стоит на рабочем этапе дальше
 * «Взята в работу» или подписана. «Неразобранное», «Заявка получена»,
 * «Взята в работу» и всё, что стоит в воронке раньше них, в квалы не идёт,
 * как и «Закрыто и не реализовано». Каждое утро лист «Разбор дня» показывает
 * по каждой вчерашней заявке, куда она попала и почему.
 */
var ВОРОНКА_ОСНОВНАЯ = 5466436;
var НЕ_КВАЛ = ['заявка получена', 'взята в работу'];   // по названию этапа; отказ (143) отсекается отдельно

var МЕСЯЦЫ = ['Январь','Февраль','Март','Апрель','Май','Июнь',
              'Июль','Август','Сентябрь','Октябрь','Ноябрь','Декабрь'];

// Колонки источников в порядке отчёта отдела и слова, по которым источник узнаётся в CRM.
var ИСТОЧНИКИ = [
  { колонка: 'Инста',            слова: ['инст', 'instagram', 'insta'] },
  { колонка: 'Вк',               слова: ['вк', 'vk', 'вконтакте'] },
  { колонка: 'Звонки',           слова: ['звон', 'телефон'] },
  { колонка: 'сайт',             слова: ['сайт', 'site', 'тильд', 'tilda'] },
  { колонка: 'Сарафан',          слова: ['сараф', 'рекоменд', 'знаком'] },
  { колонка: 'Телеграмм',        слова: ['телегр', 'telegram', 'тг'] },
  { колонка: 'Авито',            слова: ['авито', 'avito'] },
  { колонка: 'Авитолог',         слова: ['авитолог'] },
  { колонка: 'Наружняя реклама', слова: ['наруж', 'баннер', 'вывеск'] },
  { колонка: 'Мессенджер',       слова: ['мессендж', 'whatsapp', 'ватсап', 'вотсап'] },
  { колонка: 'Партнерка',        слова: ['партн'] }
];

// Раскладка листа, как в отчёте отдела. Номера колонок с единицы.
var К = {
  дата: 1, заявки: 2, квалы: 3, взяты: 4, отложенные: 5, здесь: 6, замеры: 7,
  договоры: 8, сумма: 9, источникДоговора: 10, суммаСНачала: 11,
  источники: 12,            // 12..22: Инста … Партнерка
  план: 23, день: 24, доля: 25, runRate: 26, комментарий: 27
};
var ПЕРВАЯ_СТРОКА = 6;      // строка 1 числа; строка дня = 5 + число

/**
 * Возвращает книгу для отчёта. Исходный файл отдела лежит в формате Excel
 * и принадлежит другому человеку, писать в него нельзя, поэтому агент
 * ведёт собственную таблицу в том же формате.
 */
function книгаОтчёта_() {
  var хранилище = PropertiesService.getScriptProperties();
  var id = хранилище.getProperty('таблицаОтчёта');
  if (id) {
    try { return SpreadsheetApp.openById(id); }
    catch (e) { хранилище.deleteProperty('таблицаОтчёта'); }
  }
  if (НАСТРОЙКИ.таблицаId) {
    try {
      var своя = SpreadsheetApp.openById(НАСТРОЙКИ.таблицаId);
      хранилище.setProperty('таблицаОтчёта', НАСТРОЙКИ.таблицаId);
      return своя;
    } catch (e) {
      Logger.log('Настроенный файл открыть не получилось: это книга Excel, а не Google-таблица. Создаю отдельную.');
    }
  }
  var книга = SpreadsheetApp.create('Shumm · отчёт по продажам');
  хранилище.setProperty('таблицаОтчёта', книга.getId());
  Logger.log('Создал таблицу отчёта: ' + книга.getUrl());
  return книга;
}

/** Год, месяц (с нуля) и число по Москве. */
function деньМск_(дата) {
  var ч = Utilities.formatDate(дата, 'Europe/Moscow', 'yyyy-M-d').split('-');
  return { год: +ч[0], месяц: +ч[1] - 1, число: +ч[2] };
}

/** Границы московских суток в секундах. В Москве круглый год UTC+3. */
function границыДня_(д) {
  var начало = Date.UTC(д.год, д.месяц, д.число) / 1000 - 3 * 3600;
  return { начало: начало, конец: начало + 86400 };
}

function подписьДня_(д) {
  return ('0' + д.число).slice(-2) + '.' + ('0' + (д.месяц + 1)).slice(-2) + '.' + д.год;
}

/** Лист месяца в формате отчёта отдела. Если его нет, собирается со всеми формулами. */
function листОтчёта_(книга, д) {
  var имя = МЕСЯЦЫ[д.месяц] + ' - ' + д.год;
  var лист = книга.getSheetByName(имя);
  if (лист) return лист;

  var дней = new Date(д.год, д.месяц + 1, 0).getDate();
  лист = книга.insertSheet(имя, 0);
  var шапка = ['', 'Количество заявок', 'Кваллид', 'Взята в работу', 'Отложенный спрос',
    'Работаем здесь и сейчас', 'Количество замеров', 'Количество договоров', 'Сумма договора',
    'Источник договора', 'Сумма с начала месяца']
    .concat(ИСТОЧНИКИ.map(function (и) { return и.колонка; }))
    .concat(['Процент выполнения плана %', 'День', 'Доля месяца', 'RUN RATE%', 'Комментарий агента']);
  лист.getRange(1, 1, 1, шапка.length).setValues([шапка]).setFontWeight('bold').setWrap(true);
  лист.getRange(2, 1).setValue('ПЛАН');
  лист.getRange(3, 1).setValue(НАСТРОЙКИ.планМесяца).setNumberFormat('# ##0 ₽');
  лист.getRange(5, 1).setValue('Дата').setFontWeight('bold');

  // Строка 4: доля от заявок, строка 5: итоги месяца.
  var посл = ПЕРВАЯ_СТРОКА + дней - 1;
  for (var к = К.заявки; к <= К.договоры; к++) {
    var б = колонка_(к);
    лист.getRange(4, к).setFormula('=IF($B$5=0,0,' + б + '5/$B$5)');
  }
  var итоги = [К.заявки, К.квалы, К.взяты, К.отложенные, К.здесь, К.замеры, К.договоры, К.сумма];
  for (var и = 0; и < ИСТОЧНИКИ.length; и++) итоги.push(К.источники + и);
  итоги.forEach(function (к) {
    var б = колонка_(к);
    лист.getRange(5, к).setFormula('=SUM(' + б + ПЕРВАЯ_СТРОКА + ':' + б + посл + ')');
  });

  var строки = [];
  for (var ч = 1; ч <= дней; ч++) {
    var р = ПЕРВАЯ_СТРОКА + ч - 1;
    строки.push(р);
    лист.getRange(р, К.дата).setFormula('=DATE(' + д.год + ',' + (д.месяц + 1) + ',' + ч + ')');
    лист.getRange(р, К.суммаСНачала).setFormula('=SUM($I$' + ПЕРВАЯ_СТРОКА + ':I' + р + ')');
    лист.getRange(р, К.план).setFormula('=IF($A$3=0,0,K' + р + '/$A$3)');
    лист.getRange(р, К.день).setValue(ч);
    лист.getRange(р, К.доля).setFormula('=X' + р + '/' + дней);
    лист.getRange(р, К.runRate).setFormula('=IF(OR($A$3=0,Y' + р + '=0),0,K' + р + '/($A$3*Y' + р + '))');
  }

  лист.getRange(4, 2, 1, К.договоры - 1).setNumberFormat('0%');
  лист.getRange(ПЕРВАЯ_СТРОКА, 1, дней, 1).setNumberFormat('dd.MM.yyyy');
  лист.getRange(5, К.сумма, дней + 1, 1).setNumberFormat('# ##0 ₽');
  лист.getRange(ПЕРВАЯ_СТРОКА, К.суммаСНачала, дней, 1).setNumberFormat('# ##0 ₽');
  лист.getRange(ПЕРВАЯ_СТРОКА, К.план, дней, 1).setNumberFormat('0.0%');
  лист.getRange(ПЕРВАЯ_СТРОКА, К.доля, дней, 1).setNumberFormat('0.00');
  лист.getRange(ПЕРВАЯ_СТРОКА, К.runRate, дней, 1).setNumberFormat('0.0%');
  лист.getRange(ПЕРВАЯ_СТРОКА, К.замеры, дней, 1).setBackground('#fff8e1')
    .setNote('Замеры заполняет руководитель. Агент эту колонку не трогает.');
  лист.setFrozenRows(5);
  лист.setFrozenColumns(1);
  лист.setColumnWidth(К.комментарий, 320);
  Logger.log('Собрал лист «' + имя + '» в формате отчёта отдела.');
  return лист;
}

/** Буква колонки по номеру: 1 → A, 27 → AA. */
function колонка_(н) {
  var с = '';
  while (н > 0) { var о = (н - 1) % 26; с = String.fromCharCode(65 + о) + с; н = Math.floor((н - 1) / 26); }
  return с;
}

/** Названия этапов двух воронок отчёта: «воронка:этап» → название строчными. */
function этапыОтчёта_() {
  var воронки = (запросAmo_('leads/pipelines')._embedded || {}).pipelines || [];
  var названия = {};
  воронки.forEach(function (в) {
    if (в.id !== ВОРОНКА_ОСНОВНАЯ && в.id !== ВОРОНКА_ОТЛОЖЕННЫХ) return;
    ((в._embedded || {}).statuses || []).forEach(function (с) {
      названия[в.id + ':' + с.id] = { имя: String(с.name || '').toLowerCase(), порядок: с.sort || 0, тип: с.type || 0 };
    });
  });
  return названия;
}

/** Последний «не квал» этап воронки: по его порядку отсекается всё, что раньше. */
function граница_(этапы, воронка) {
  var граница = -Infinity;
  Object.keys(этапы).forEach(function (к) {
    if (к.indexOf(воронка + ':') !== 0) return;
    var э = этапы[к];
    if (НЕ_КВАЛ.some(function (н) { return э.имя.indexOf(н) > -1; })) граница = Math.max(граница, э.порядок);
  });
  return граница;
}

/** Что это за заявка для отчёта: не наша воронка, отказ, взята в работу, не квал или квал. */
function вердикт_(с, справка) {
  if (с.pipeline_id !== ВОРОНКА_ОСНОВНАЯ && с.pipeline_id !== ВОРОНКА_ОТЛОЖЕННЫХ) return 'другая воронка';
  if (с.status_id === ПРОИГРАНА) return 'отказ';
  if (с.status_id === ВЫИГРАНА) return 'квал';
  var э = справка.этапы[с.pipeline_id + ':' + с.status_id] || { имя: '', порядок: 0, тип: 0 };
  if (э.имя.indexOf('взята в работу') > -1) return 'взята в работу';
  if (э.тип === 1 || э.имя.indexOf('неразобран') > -1 || !э.имя) return 'не квал';
  if (НЕ_КВАЛ.some(function (н) { return э.имя.indexOf(н) > -1; })) return 'не квал';
  if (э.порядок <= граница_(справка.этапы, с.pipeline_id)) return 'не квал';
  return 'квал';
}

/**
 * Поле CRM, в котором записан источник обращения. Ищется само: по слову
 * «источник» в названии и по знакомым источникам в вариантах выбора.
 */
function полеИсточника_() {
  var поля = ((запросAmo_('leads/custom_fields', { limit: 250 }) || {})._embedded || {}).custom_fields || [];
  var лучшее = null, лучшийСчёт = 0;
  поля.forEach(function (п) {
    var счёт = /источник|source/i.test(п.name || '') ? 3 : 0;
    (п.enums || []).forEach(function (в) { if (колонкаИсточника_(в.value)) счёт++; });
    if (счёт > лучшийСчёт) { лучшее = п; лучшийСчёт = счёт; }
  });
  return лучшее ? { id: лучшее.id, имя: лучшее.name } : null;
}

/** Колонка отчёта по тексту источника. Выигрывает самое длинное совпадение: «Авитолог» не станет «Авито». */
function колонкаИсточника_(текст) {
  var т = String(текст || '').toLowerCase();
  if (!т) return '';
  var найдено = '', длина = 0;
  ИСТОЧНИКИ.forEach(function (и) {
    и.слова.forEach(function (с) {
      if (т.indexOf(с) > -1 && с.length > длина) { найдено = и.колонка; длина = с.length; }
    });
  });
  return найдено;
}

/** Текст источника у сделки: из найденного поля, а если там пусто, из меток. */
function источникСделки_(сделка, поле) {
  if (поле) {
    var значения = (сделка.custom_fields_values || []).filter(function (п) { return п.field_id === поле.id; });
    var текст = значения.length ? ((значения[0].values || [])[0] || {}).value : '';
    if (текст) return String(текст);
  }
  var метки = ((сделка._embedded || {}).tags || []).map(function (м) { return м.name; });
  for (var i = 0; i < метки.length; i++) if (колонкаИсточника_(метки[i])) return метки[i];
  return '';
}

/**
 * Цифры за один день. Сделки берутся из CRM сейчас, поэтому квалы показывают,
 * где вчерашние заявки стоят на момент заполнения.
 */
function цифрыЗаДень_(д, справка) {
  var г = границыДня_(д);
  var пришедшие = страницы_({ 'filter[created_at][from]': г.начало, 'filter[created_at][to]': г.конец - 1 });
  var закрытые = страницы_({ 'filter[closed_at][from]': г.начало, 'filter[closed_at][to]': г.конец - 1 })
    .filter(function (с) {
      return с.status_id === ВЫИГРАНА && (с.pipeline_id === ВОРОНКА_ОСНОВНАЯ || с.pipeline_id === ВОРОНКА_ОТЛОЖЕННЫХ);
    });

  пришедшие = пришедшие.filter(function (с) {
    return с.pipeline_id === ВОРОНКА_ОСНОВНАЯ || с.pipeline_id === ВОРОНКА_ОТЛОЖЕННЫХ;
  });
  var р = { заявки: пришедшие.length, взяты: 0, отложенные: 0, здесь: 0, источники: {},
            договоры: закрытые.length, сумма: 0, источникДоговора: [], непонятные: {} };
  ИСТОЧНИКИ.forEach(function (и) { р.источники[и.колонка] = 0; });

  function учестьИсточник(сделка) {
    var текст = источникСделки_(сделка, справка.поле);
    var колонка = колонкаИсточника_(текст);
    if (колонка) р.источники[колонка]++;
    else { var ключ = текст || 'не указан'; р.непонятные[ключ] = (р.непонятные[ключ] || 0) + 1; }
  }

  р.разбор = [];
  пришедшие.forEach(function (с) {
    var вердикт = вердикт_(с, справка);
    var э = справка.этапы[с.pipeline_id + ':' + с.status_id] || { имя: '' };
    р.разбор.push([с.id, с.name || '', с.pipeline_id === ВОРОНКА_ОТЛОЖЕННЫХ ? 'Отложенный спрос' : 'Основная',
                   с.status_id === ВЫИГРАНА ? 'договор подписан' : с.status_id === ПРОИГРАНА ? 'закрыто и не реализовано' : э.имя,
                   источникСделки_(с, справка.поле) || '', вердикт]);
    if (вердикт === 'взята в работу') { р.взяты++; return; }
    if (вердикт !== 'квал') return;
    if (с.pipeline_id === ВОРОНКА_ОТЛОЖЕННЫХ) р.отложенные++; else р.здесь++;
    учестьИсточник(с);
  });

  закрытые.forEach(function (с) {
    р.сумма += с.price || 0;
    var текст = источникСделки_(с, справка.поле);
    р.источникДоговора.push(колонкаИсточника_(текст) || текст || '?');
  });
  р.квалы = р.отложенные + р.здесь;
  return р;
}

/** Записывает день в его строку. Колонку замеров не трогает: её ведёт руководитель. */
function записатьДень_(лист, д, р, пометка) {
  var строка = ПЕРВАЯ_СТРОКА + д.число - 1;
  лист.getRange(строка, К.заявки, 1, 5).setValues([[р.заявки, р.квалы, р.взяты, р.отложенные, р.здесь]]);
  лист.getRange(строка, К.договоры, 1, 3).setValues([[р.договоры, р.сумма, р.источникДоговора.join(', ')]]);
  лист.getRange(строка, К.источники, 1, ИСТОЧНИКИ.length)
    .setValues([ИСТОЧНИКИ.map(function (и) { return р.источники[и.колонка]; })]);
  var непонятные = Object.keys(р.непонятные).map(function (к) { return к + ' ' + р.непонятные[к]; });
  var комментарий = [пометка || '', непонятные.length ? 'Источник не распознан: ' + непонятные.join(', ') : '']
    .filter(String).join('. ');
  лист.getRange(строка, К.комментарий).setValue(комментарий);
  return строка;
}

function справкаОтчёта_() {
  var поле = полеИсточника_();
  Logger.log(поле ? ('Источник беру из поля «' + поле.имя + '».') : 'Поле источника в CRM не нашёл, смотрю метки сделок.');
  return { этапы: этапыОтчёта_(), поле: поле };
}

/**
 * Главное: заполняет строку за вчера, дозаполняет пропущенные дни месяца
 * и присылает уведомление в Telegram. Стоит в расписании на 10:00.
 */
function утреннийОтчёт() {
  var вчера = деньМск_(new Date(Date.now() - 86400000));
  var справка = справкаОтчёта_();
  var лист = листОтчёта_(книгаОтчёта_(), вчера);

  // Дни, которые пропустило расписание, заполняются задним числом.
  var пустые = [];
  if (вчера.число > 1) {
    var колонка = лист.getRange(ПЕРВАЯ_СТРОКА, К.заявки, вчера.число - 1, 1).getValues();
    колонка.forEach(function (к, i) { if (к[0] === '' || к[0] === null) пустые.push(i + 1); });
  }
  пустые.forEach(function (число) {
    var д = { год: вчера.год, месяц: вчера.месяц, число: число };
    записатьДень_(лист, д, цифрыЗаДень_(д, справка), 'Заполнено задним числом, этапы на момент заполнения');
  });

  var р = цифрыЗаДень_(вчера, справка);
  записатьДень_(лист, вчера, р, '');
  записатьРазбор_(лист.getParent(), вчера, р);
  SpreadsheetApp.flush();
  Logger.log('Отчёт за ' + подписьДня_(вчера) + ' заполнен' + (пустые.length ? ', дозаполнено дней: ' + пустые.length : '') + '.');
  уведомитьОбОтчёте_(лист, вчера, р, пустые.length);
  return 'Готово';
}

/** Пересчитывает все дни месяца до вчерашнего включительно. Замеры не трогает. */
function пересчитатьМесяц() {
  var вчера = деньМск_(new Date(Date.now() - 86400000));
  var справка = справкаОтчёта_();
  var лист = листОтчёта_(книгаОтчёта_(), вчера);
  for (var ч = 1; ч <= вчера.число; ч++) {
    var д = { год: вчера.год, месяц: вчера.месяц, число: ч };
    записатьДень_(лист, д, цифрыЗаДень_(д, справка), ч < вчера.число ? 'Пересчитано задним числом, этапы на момент пересчёта' : '');
  }
  записатьРазбор_(лист.getParent(), вчера, цифрыЗаДень_(вчера, справка));
  Logger.log('Пересчитано дней: ' + вчера.число + '. Таблица: ' + лист.getParent().getUrl());
  return 'Готово';
}

/** Лист «Разбор дня»: каждая вчерашняя заявка и куда она попала. Перезаписывается каждое утро. */
function записатьРазбор_(книга, д, р) {
  var лист = книга.getSheetByName('Разбор дня') || книга.insertSheet('Разбор дня');
  лист.clear();
  var строки = [['Разбор за ' + подписьДня_(д), '', '', '', '', ''],
                ['Номер сделки', 'Название', 'Воронка', 'Этап сейчас', 'Источник', 'В отчёте']].concat(р.разбор);
  лист.getRange(1, 1, строки.length, 6).setValues(строки);
  лист.getRange(2, 1, 1, 6).setFontWeight('bold');
}

/** Сообщение в Telegram о том, что отчёт готов. */
function уведомитьОбОтчёте_(лист, д, р, дозаполнено) {
  if (!НАСТРОЙКИ.telegramТокен || НАСТРОЙКИ.telegramТокен.indexOf('ВСТАВЬТЕ') === 0) return;
  var чат = найтиЧат_();
  if (!чат) { Logger.log('Уведомление не отправлено: не знаю чат.'); return; }
  var строка = ПЕРВАЯ_СТРОКА + д.число - 1;
  var план = лист.getRange(строка, К.план).getValue() || 0;
  var runRate = лист.getRange(строка, К.runRate).getValue() || 0;
  var источники = ИСТОЧНИКИ.filter(function (и) { return р.источники[и.колонка]; })
    .map(function (и) { return и.колонка + ' ' + р.источники[и.колонка]; });
  var деньги = function (n) { return String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' ₽'; };
  var строки = [
    'Отчёт за ' + подписьДня_(д) + ' заполнен.',
    '',
    'Заявок: ' + р.заявки,
    'Квалов: ' + р.квалы + ' (здесь и сейчас ' + р.здесь + ', отложенный спрос ' + р.отложенные + ')',
    'Взято в работу: ' + р.взяты
  ];
  if (источники.length) строки.push('Источники квалов: ' + источники.join(', '));
  строки.push('Договоров: ' + р.договоры + (р.договоры ? ' на ' + деньги(р.сумма) + ' (' + р.источникДоговора.join(', ') + ')' : ''));
  строки.push('План месяца: ' + Math.round(план * 1000) / 10 + '%, run rate ' + Math.round(runRate * 1000) / 10 + '%');
  if (дозаполнено) строки.push('Дозаполнил пропущенных дней: ' + дозаполнено);
  строки.push('', 'Замеры за вами. ' + лист.getParent().getUrl() + '#gid=' + лист.getSheetId());
  var текст = строки.join('\n');
  var ответ = написать_(чат, текст);
  Logger.log('Уведомление об отчёте, ответ Telegram ' + ответ.getResponseCode());
}

/** Проверка без записи в отчёт: показывает, что попадёт в строку за вчера, и обновляет лист «Разбор дня». */
function проверкаОтчёта() {
  var вчера = деньМск_(new Date(Date.now() - 86400000));
  var справка = справкаОтчёта_();
  Logger.log('Этапы воронок отчёта: ' + JSON.stringify(справка.этапы));
  var р = цифрыЗаДень_(вчера, справка);
  записатьРазбор_(книгаОтчёта_(), вчера, р);
  Logger.log('За ' + подписьДня_(вчера) + ': ' + JSON.stringify(р));
  return р;
}

/** Показывает, где живёт таблица отчёта. */
function адресОтчёта() {
  var книга = книгаОтчёта_();
  Logger.log('Таблица отчёта: ' + книга.getUrl());
  return книга.getUrl();
}

/* ====================== сводка в Telegram ====================== */

/**
 * Находит ваш чат сам: достаточно один раз написать боту любое сообщение.
 * Найденный номер запоминается, повторно искать не нужно.
 */
function найтиЧат_() {
  if (НАСТРОЙКИ.telegramЧат) { Logger.log('Чат взят из настроек: ' + НАСТРОЙКИ.telegramЧат); return НАСТРОЙКИ.telegramЧат; }
  var хранилище = PropertiesService.getScriptProperties();
  var сохранённый = хранилище.getProperty('чат');
  if (сохранённый) { Logger.log('Чат уже был найден раньше: ' + сохранённый); return сохранённый; }

  var ответ = UrlFetchApp.fetch(
    'https://api.telegram.org/bot' + НАСТРОЙКИ.telegramТокен + '/getUpdates',
    { muteHttpExceptions: true });
  var код = ответ.getResponseCode();
  var тело = ответ.getContentText();
  Logger.log('Спросил у Telegram новые сообщения, ответ ' + код);
  if (код === 409) {
    Logger.log('У Telegram ещё задан вебхук, он мешает. Запустите подключитьСекретаря, он его снимет.');
    return '';
  }
  if (код !== 200) {
    Logger.log('Telegram отказал. Это почти всегда неверный токен бота. Ответ: ' + тело.slice(0, 300));
    return '';
  }
  var данные = JSON.parse(тело || '{}');
  var обновления = данные.result || [];
  Logger.log('Сообщений в очереди: ' + обновления.length);
  if (!обновления.length) {
    Logger.log('Очередь пуста. Причины бывают две: вы ещё не писали боту, либо сообщения уже забрал ' +
      'другой сервис, подключённый к этому же боту. Напишите боту ещё раз и запустите снова.');
  }
  for (var i = обновления.length - 1; i >= 0; i--) {
    var сообщение = обновления[i].message || обновления[i].edited_message;
    if (сообщение && сообщение.chat && сообщение.chat.id) {
      var чат = String(сообщение.chat.id);
      хранилище.setProperty('чат', чат);
      Logger.log('Нашёл ваш чат: ' + чат + '. Запомнил, больше искать не буду.');
      return чат;
    }
  }
  return '';
}

/** Разбирает по шагам, почему сводка не дошла. Запускать при любой заминке с Telegram. */
function проверкаTelegram() {
  if (!НАСТРОЙКИ.telegramТокен || НАСТРОЙКИ.telegramТокен.indexOf('ВСТАВЬТЕ') === 0) {
    Logger.log('Токен бота не вписан в настройки.');
    return;
  }
  var кто = UrlFetchApp.fetch('https://api.telegram.org/bot' + НАСТРОЙКИ.telegramТокен + '/getMe',
    { muteHttpExceptions: true });
  if (кто.getResponseCode() !== 200) {
    Logger.log('Telegram не признал токен. Ответ: ' + кто.getContentText().slice(0, 300));
    return;
  }
  var имя = (JSON.parse(кто.getContentText()).result || {}).username;
  Logger.log('Бот на связи: @' + имя + '. Именно ему нужно написать сообщение.');

  var чат = найтиЧат_();
  if (!чат) { Logger.log('Чат не найден, отправлять некуда.'); return; }

  var отправка = UrlFetchApp.fetch('https://api.telegram.org/bot' + НАСТРОЙКИ.telegramТокен + '/sendMessage', {
    method: 'post',
    payload: { chat_id: чат, text: 'Shumm на связи. Это проверочное сообщение.' },
    muteHttpExceptions: true
  });
  Logger.log('Отправка, ответ ' + отправка.getResponseCode() + ': ' + отправка.getContentText().slice(0, 300));
}

/** Забывает найденный чат, чтобы искать заново. */
function сброситьЧат() {
  PropertiesService.getScriptProperties().deleteProperty('чат');
  Logger.log('Чат забыт. Напишите боту и запустите проверкаTelegram.');
}

function отправитьСводку() {
  if (!НАСТРОЙКИ.telegramТокен) { Logger.log('Токен бота не вписан.'); return 'Telegram не настроен'; }
  var чат = найтиЧат_();
  if (!чат) {
    Logger.log('Не знаю, в какой чат слать. Напишите боту сообщение и запустите проверкаTelegram.');
    return 'Чат не найден';
  }
  var ц = собратьЦифры();
  var план = ц.plan.target ? Math.round(ц.plan.done / ц.plan.target * 100) : 0;
  var текст = [
    'Доброе утро. Сводка на ' + Utilities.formatDate(new Date(), 'Europe/Moscow', 'dd.MM'),
    '',
    'Конверсия в замер: ' + ц.conversion.current + '% при цели ' + ц.conversion.goal + '%',
    'План месяца: ' + план + '%',
    'Квалы ' + ц.funnel.quals + ' · замеры ' + ц.funnel.measures + ' · договоры ' + ц.funnel.contracts,
    '',
    ц.problems.length ? ('Требуют вас: ' + ц.problems.length) : 'Зависших сделок нет',
    '',
    'Планёрка: что главное на сегодня? Ответьте списком, каждое дело с новой строки. ' +
    'Время можно указать в начале строки, например «14:00 планёрка с отделом».'
  ].join('\n');

  var ответ = написать_(чат, текст);
  Logger.log('Отправка сводки в чат ' + чат + ', ответ ' + ответ.getResponseCode() +
    ': ' + ответ.getContentText().slice(0, 300));
  return 'Отправлено в чат ' + чат;
}

/** Отправляет сообщение в Telegram. Возвращает ответ сервера как есть. */
function написать_(чат, текст) {
  return UrlFetchApp.fetch('https://api.telegram.org/bot' + НАСТРОЙКИ.telegramТокен + '/sendMessage', {
    method: 'post',
    payload: { chat_id: чат, text: текст },
    muteHttpExceptions: true
  });
}

/* ====================== секретарь ====================== */

/**
 * Секретарь живёт в том же боте. В 9:05 он просит список дел на день,
 * а любой ваш ответ в чате разбирает по строкам и кладёт в список,
 * который приложение забирает по адресу с параметром do=tasks.
 *
 * Сообщения секретарь забирает у Telegram сам, раз в минуту. Стучаться в скрипт
 * напрямую Telegram не может: Google отвечает ему переадресацией (302), а Telegram
 * переадресации не принимает и копит очередь. Поэтому ответ бота приходит в
 * течение минуты, а не мгновенно.
 */

function сегодняКлюч_() {
  return Utilities.formatDate(new Date(), 'Europe/Moscow', 'yyyy-MM-dd');
}

/** Ключ дня со сдвигом от сегодня: 0 сегодня, 1 завтра. */
function ключСоСдвигом_(сдвиг) {
  var д = new Date(); д.setDate(д.getDate() + (сдвиг || 0));
  return Utilities.formatDate(д, 'Europe/Moscow', 'yyyy-MM-dd');
}

/** Дата из запроса приложения. Кривая или пустая дата означает сегодня. */
function ключДня_(текст) {
  return /^\d{4}-\d{2}-\d{2}$/.test(String(текст || '')) ? String(текст) : сегодняКлюч_();
}

function имяДня_(ключ) {
  var сегодня = сегодняКлюч_();
  if (ключ === сегодня) return 'сегодня';
  if (ключ === ключСоСдвигом_(1)) return 'завтра';
  if (ключ === ключСоСдвигом_(2)) return 'послезавтра';
  var ч = ключ.split('-');
  return ч[2] + '.' + ч[1];
}

function делаЗаДень_(ключДня) {
  var сырое = PropertiesService.getScriptProperties().getProperty('дела:' + ключДня);
  try { return сырое ? JSON.parse(сырое) : []; } catch (e) { return []; }
}

function сохранитьДела_(ключДня, список) {
  var хранилище = PropertiesService.getScriptProperties();
  хранилище.setProperty('дела:' + ключДня, JSON.stringify(список));
  // Списки старше двух недель больше никому не нужны.
  var порог = new Date(); порог.setDate(порог.getDate() - 14);
  var порогКлюч = Utilities.formatDate(порог, 'Europe/Moscow', 'yyyy-MM-dd');
  Object.keys(хранилище.getProperties()).forEach(function (к) {
    if (к.indexOf('дела:') === 0 && к.slice(5) < порогКлюч) хранилище.deleteProperty(к);
  });
}

/**
 * Разбирает текст сообщения на дела: каждая непустая строка — отдельное дело.
 * Маркеры вроде «1.», «-», «•» убираются, время в начале строки уходит в срок.
 */
function разобратьДела_(текст) {
  return String(текст || '').split(/\r?\n/).map(function (строка) {
    var чистая = строка.replace(/^[\s\-•*·]+/, '').replace(/^\d+[.)]\s*/, '').trim();
    if (!чистая) return null;
    var сдвиг = 0;
    if (/(^|\s)послезавтра(\s|$)/i.test(чистая)) { сдвиг = 2; чистая = чистая.replace(/(^|\s)послезавтра(?=\s|$)/i, ' ').trim(); }
    else if (/(^|\s)завтра(\s|$)/i.test(чистая)) { сдвиг = 1; чистая = чистая.replace(/(^|\s)завтра(?=\s|$)/i, ' ').trim(); }
    чистая = чистая.replace(/\s{2,}/g, ' ');
    var срок = '';
    var время = чистая.match(/^(?:в\s+)?(\d{1,2})[:.](\d{2})\s*[—\-–:]?\s*(.+)$/);
    if (время) {
      срок = ('0' + время[1]).slice(-2) + ':' + время[2];
      чистая = время[3].trim();
    } else {
      var хвост = чистая.match(/^(.+?)\s+(?:(?:в|к)\s+)?(\d{1,2})[:.](\d{2})$/);
      if (хвост) { срок = ('0' + хвост[2]).slice(-2) + ':' + хвост[3]; чистая = хвост[1].trim(); }
    }
    return чистая ? { text: чистая, when: срок, shift: сдвиг } : null;
  }).filter(Boolean);
}

/**
 * Запасной вход: если когда-нибудь Telegram научится принимать ответ Google,
 * сообщения можно будет носить и сюда. Сейчас рабочий путь — секретарьОпрос.
 */
function doPost(e) {
  var параметры = (e && e.parameter) || {};
  if (параметры.do === 'state-set') {
    var ответ;
    if (параметры.key !== НАСТРОЙКИ.ключ) {
      ответ = { error: 'Неверный ключ' };
    } else {
      try {
        var тело = JSON.parse((e.postData && e.postData.contents) || '{}');
        ответ = { version: ВЕРСИЯ, saved: записатьСостояние_(тело.key, тело.value, Number(тело.updated) || Date.now()) };
      } catch (err) {
        ответ = { error: String(err && err.message ? err.message : err) };
      }
    }
    return ContentService.createTextOutput(JSON.stringify(ответ)).setMimeType(ContentService.MimeType.JSON);
  }
  try {
    var обновление = JSON.parse((e && e.postData && e.postData.contents) || '{}');
    var сообщение = обновление.message || обновление.edited_message;
    if (сообщение && сообщение.chat) обработатьСообщение_(сообщение, обновление.update_id);
  } catch (err) {
    Logger.log('Секретарь не разобрал сообщение: ' + err);
  }
  // Telegram ждёт короткий ответ, иначе будет присылать то же сообщение снова.
  return ContentService.createTextOutput('ok');
}

function обработатьСообщение_(сообщение, номер) {
  var хранилище = PropertiesService.getScriptProperties();
  var чат = String(сообщение.chat.id);
  var известный = НАСТРОЙКИ.telegramЧат || хранилище.getProperty('чат');
  if (!известный) {
    хранилище.setProperty('чат', чат);
    известный = чат;
  }
  // Секретарь работает только с хозяином: посторонние чаты молча пропускаем.
  if (чат !== String(известный)) return;

  // Одно и то же сообщение Telegram может принести дважды: второй раз не записываем.
  if (номер && хранилище.getProperty('последнееСообщение') === String(номер)) return;
  if (номер) хранилище.setProperty('последнееСообщение', String(номер));

  var текст = String(сообщение.text || '').trim();
  if (!текст) { написать_(чат, 'Я понимаю только текст: пришлите дела списком.'); return; }

  var команда = текст.toLowerCase().replace(/^\//, '');
  if (команда === 'start' || команда === 'помощь' || команда === 'help') {
    написать_(чат, 'Я секретарь Shumm. Пришлите дела на сегодня, каждое с новой строки, ' +
      'и они появятся в приложении. Слово «завтра» в строке переносит дело на завтра. ' +
      '«Список» покажет сегодняшнее, «список завтра» — завтрашнее, «очистить» уберёт сегодняшний список.');
    return;
  }
  var ключ = сегодняКлюч_();
  if (/^(список|дела)(\s+(завтра|послезавтра))?$/.test(команда)) {
    var какой = /послезавтра/.test(команда) ? ключСоСдвигом_(2) : /завтра/.test(команда) ? ключСоСдвигом_(1) : ключ;
    var есть = делаСКалендарём_(какой);
    написать_(чат, есть.length ? ('На ' + имяДня_(какой) + ' записано:\n' + есть.map(строкаДела_).join('\n'))
                               : 'На ' + имяДня_(какой) + ' пока ничего не записано.');
    return;
  }
  if (команда === 'очистить') {
    сохранитьДела_(ключ, []);
    написать_(чат, 'Сегодняшний список очищен.');
    return;
  }

  var новые = разобратьДела_(текст);
  if (!новые.length) { написать_(чат, 'Не нашёл в сообщении ни одного дела.'); return; }

  var метка = Date.now(), поДням = {};
  новые.forEach(function (д, i) {
    var день = ключСоСдвигом_(д.shift || 0);
    delete д.shift;
    д.id = 'tg-' + метка + '-' + i;
    д.ts = метка;
    делоВКалендарь_(д, день);
    поДням[день] = поДням[день] || [];
    поДням[день].push(д);
  });
  var строки = [];
  Object.keys(поДням).sort().forEach(function (день) {
    var список = делаЗаДень_(день).concat(поДням[день]);
    сохранитьДела_(день, список);
    строки.push('На ' + имяДня_(день) + ':\n' + поДням[день].map(строкаДела_).join('\n'));
  });
  написать_(чат, 'Записал ' + склонение_(новые.length, 'дело', 'дела', 'дел') + '.\n' +
    строки.join('\n') + '\n\nВ Shumm появятся при следующем обновлении.');
}

/** Отмечает дело выполненным. Список возвращается целиком, чтобы приложение не гадало. */
function отметитьДелоВПриложении_(номер, готово, ключ) {
  ключ = ключ || сегодняКлюч_();
  var список = делаЗаДень_(ключ);
  var нашлось = false;
  список.forEach(function (д) { if (д.id === номер) { д.done = !!готово; нашлось = true; отметкаВКалендарь_(д); } });
  if (нашлось) сохранитьДела_(ключ, список);
  return { version: ВЕРСИЯ, date: ключ, tasks: список, found: нашлось };
}

/** Добавляет дело из приложения. Разбор тот же, что и для сообщений в Telegram. */
function добавитьДелоИзПриложения_(текст, срок, ключ) {
  ключ = ключ || сегодняКлюч_();
  var список = делаЗаДень_(ключ);
  var новые = разобратьДела_(текст).map(function (д) { delete д.shift; return д; });
  if (!новые.length && String(текст || '').trim()) новые = [{ text: String(текст).trim(), when: '' }];
  var метка = Date.now();
  новые.forEach(function (д, i) {
    д.id = 'app-' + метка + '-' + i;
    д.done = false;
    if (срок && !д.when) д.when = String(срок).slice(0, 12);
    делоВКалендарь_(д, ключ);
    список.push(д);
  });
  if (новые.length) сохранитьДела_(ключ, список);
  return { version: ВЕРСИЯ, date: ключ, tasks: список, added: новые.length };
}

function строкаДела_(д) { return '• ' + (д.when ? д.when + ' ' : '') + д.text; }

function склонение_(n, один, два, пять) {
  var м = n % 10, с = n % 100;
  var слово = (м === 1 && с !== 11) ? один : (м >= 2 && м <= 4 && (с < 10 || с >= 20)) ? два : пять;
  return n + ' ' + слово;
}

/**
 * Настоящий адрес веб-приложения. Из редактора getUrl() иногда отдаёт адрес
 * тестовой версии (/dev), куда Telegram не пустят без входа в Google, поэтому
 * адрес /exec запоминается в момент, когда по нему реально пришёл запрос.
 */
function запомнитьАдрес_() {
  try {
    var адрес = ScriptApp.getService().getUrl() || '';
    if (/\/exec$/.test(адрес)) PropertiesService.getScriptProperties().setProperty('адресExec', адрес);
  } catch (e) {}
}

function адресВебПриложения_() {
  var сохранённый = PropertiesService.getScriptProperties().getProperty('адресExec');
  if (сохранённый) return сохранённый;
  var адрес = ScriptApp.getService().getUrl() || '';
  return адрес.replace(/\/dev$/, '/exec');
}

/** Спрашивает у Telegram, куда он носит сообщения и что при этом случилось в последний раз. */
function состояниеВебхука_() {
  var ответ = UrlFetchApp.fetch('https://api.telegram.org/bot' + НАСТРОЙКИ.telegramТокен + '/getWebhookInfo',
    { muteHttpExceptions: true });
  var данные = {};
  try { данные = JSON.parse(ответ.getContentText()).result || {}; } catch (e) {}
  Logger.log(данные.url ? ('ВНИМАНИЕ: у Telegram задан вебхук ' + данные.url + ', он мешает опросу. Запустите подключитьСекретаря.')
                        : 'Вебхука нет, сообщения отдаются по запросу. Так и нужно.');
  Logger.log('Сообщений в очереди у Telegram: ' + (данные.pending_update_count || 0));
  if (данные.last_error_message) {
    Logger.log('Последняя ошибка Telegram (' + new Date((данные.last_error_date || 0) * 1000).toLocaleString('ru-RU') +
      '): ' + данные.last_error_message);
  } else {
    Logger.log('Ошибок доставки Telegram не видел.');
  }
  return данные;
}

/** Утренний вопрос в 9:05. Если список на сегодня уже прислан, секретарь его просто повторит. */
function секретарьУтром() {
  if (!НАСТРОЙКИ.telegramТокен || НАСТРОЙКИ.telegramТокен.indexOf('ВСТАВЬТЕ') === 0) return 'Telegram не настроен';
  var чат = найтиЧат_();
  if (!чат) { Logger.log('Секретарь: чат не найден, напишите боту любое слово.'); return 'Чат не найден'; }
  var есть = делаСКалендарём_(сегодняКлюч_());
  var текст = есть.length
    ? 'Секретарь: на сегодня уже записано ' + склонение_(есть.length, 'дело', 'дела', 'дел') + ':\n' +
      есть.map(строкаДела_).join('\n') + '\nЕсли что-то добавить, просто напишите.'
    : 'Секретарь на связи. Пришлите список дел на сегодня, каждое с новой строки. ' +
      'Время ставьте в начале строки, например «14:00 планёрка». Я положу их в приложение.';
  var ответ = написать_(чат, текст);
  Logger.log('Секретарь написал в чат ' + чат + ', ответ ' + ответ.getResponseCode());
  return 'Отправлено';
}

function естьТриггер_(имя) {
  return ScriptApp.getProjectTriggers().some(function (т) { return т.getHandlerFunction() === имя; });
}

function убратьТриггер_(имя) {
  ScriptApp.getProjectTriggers().forEach(function (т) {
    if (т.getHandlerFunction() === имя) ScriptApp.deleteTrigger(т);
  });
}

/**
 * Раз в минуту забирает у Telegram новые сообщения и отдаёт их секретарю.
 * Запускается по расписанию, которое ставит подключитьСекретаря.
 */
function секретарьОпрос() {
  if (!НАСТРОЙКИ.telegramТокен || НАСТРОЙКИ.telegramТокен.indexOf('ВСТАВЬТЕ') === 0) return;
  var замок = LockService.getScriptLock();
  if (!замок.tryLock(5000)) return;   // предыдущий опрос ещё не закончился
  try {
    var хранилище = PropertiesService.getScriptProperties();
    var смещение = Number(хранилище.getProperty('смещение') || 0);
    var ответ = UrlFetchApp.fetch('https://api.telegram.org/bot' + НАСТРОЙКИ.telegramТокен +
      '/getUpdates?timeout=0&allowed_updates=%5B%22message%22%5D' + (смещение ? '&offset=' + смещение : ''),
      { muteHttpExceptions: true });
    if (ответ.getResponseCode() !== 200) {
      Logger.log('Опрос Telegram не удался, ответ ' + ответ.getResponseCode() + ': ' + ответ.getContentText().slice(0, 200));
      return;
    }
    var обновления = (JSON.parse(ответ.getContentText() || '{}').result) || [];
    обновления.forEach(function (о) {
      var сообщение = о.message || о.edited_message;
      try { if (сообщение && сообщение.chat) обработатьСообщение_(сообщение, о.update_id); }
      catch (e) { Logger.log('Секретарь не разобрал сообщение ' + о.update_id + ': ' + e); }
      смещение = о.update_id + 1;
    });
    if (обновления.length) {
      хранилище.setProperty('смещение', String(смещение));
      Logger.log('Секретарь обработал сообщений: ' + обновления.length);
    }
  } finally {
    замок.releaseLock();
  }
}

/**
 * Включает секретаря: снимает старый вебхук, чтобы Telegram снова отдавал
 * сообщения по запросу, и ставит опрос раз в минуту. Повторный запуск не вредит.
 */
function подключитьСекретаря() {
  if (!НАСТРОЙКИ.telegramТокен || НАСТРОЙКИ.telegramТокен.indexOf('ВСТАВЬТЕ') === 0) {
    Logger.log('Токен бота не вписан в настройки.');
    return 'Нет токена';
  }
  // Старый вебхук вместе с его очередью: там лежат повторы одного и того же «тест».
  var снятие = UrlFetchApp.fetch('https://api.telegram.org/bot' + НАСТРОЙКИ.telegramТокен + '/deleteWebhook', {
    method: 'post', payload: { drop_pending_updates: 'true' }, muteHttpExceptions: true
  });
  Logger.log('Прямая доставка выключена, ответ Telegram ' + снятие.getResponseCode() + ': ' + снятие.getContentText().slice(0, 120));
  PropertiesService.getScriptProperties().deleteProperty('вебхук');
  PropertiesService.getScriptProperties().deleteProperty('смещение');

  убратьТриггер_('секретарьОпрос');
  ScriptApp.newTrigger('секретарьОпрос').timeBased().everyMinutes(1).create();
  Logger.log('Опрос Telegram поставлен раз в минуту.');

  var чат = найтиЧат_();
  Logger.log(чат ? ('Чат известен: ' + чат) : 'Чат ещё не известен: найдётся по первому сообщению боту.');
  Logger.log('СЕКРЕТАРЬ ПОДКЛЮЧЁН. Напишите боту слово «тест»: в течение минуты он ответит, что записал одно дело.');
  return 'Секретарь подключён';
}

/** Выключает секретаря: опрос останавливается, сообщения боту остаются без ответа. */
function отключитьСекретаря() {
  убратьТриггер_('секретарьОпрос');
  Logger.log('Секретарь отключён.');
}

/** Проверка секретаря без Telegram: разбирает пример и показывает, что получилось. */
