  Logger.log('Менеджеры: ' + JSON.stringify(ц.managers));
  Logger.log('Зависших сделок: ' + ц.problems.length);
  if (ц.warnings.length) Logger.log('Внимание: ' + ц.warnings.join('; '));
  return ц;
}
